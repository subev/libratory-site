# Filenames are content-hashed, so a change is a new URL
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=86400

# Not content-hashed, and unfurl caches are stubborn — keep the window short enough that a
# redrawn card reaches a crawler that re-fetches. To force one now, point og:image at /og.png?v=2
/og.png
  Cache-Control: public, max-age=3600

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
